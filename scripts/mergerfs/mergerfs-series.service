[Unit]
Description=mergerfs Serie TV (HDD1 + m3u-editor strm)
After=local-fs.target network-online.target mergerfs-movies.service
Before=docker.service containerd.service mergerfs.target
PartOf=mergerfs.target
RequiresMountsFor=/mnt/wsl/HDD1

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do mountpoint -q /mnt/wsl/HDD1 && test -d /mnt/wsl/HDD1/Serie_Tv && test -d /home/fabio/m3u-editor/series && exit 0; sleep 1; done; echo "HDD1 Serie_Tv o m3u-editor non pronti"; exit 1'
ExecStart=/usr/bin/mergerfs -o allow_other,use_ino,category.create=ff,minfreespace=4G,fsname=mergerfs_Serie_Tv /mnt/wsl/HDD1/Serie_Tv:/home/fabio/m3u-editor/series /mnt/union/Serie_Tv
ExecStop=/usr/bin/fusermount3 -u /mnt/union/Serie_Tv

[Install]
WantedBy=multi-user.target mergerfs.target
