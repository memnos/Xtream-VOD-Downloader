# Copy to .env and adjust paths for your system
TZ=UTC
# Must match the user Emby runs as (on Linux: id emby)
PUID=1000
PGID=1000

# UI language: en or it (can also be changed in the sidebar)
UI_LANG=en

# Optional media server defaults (can also be set in the web UI)
# EMBY_URL=http://localhost:8096
# EMBY_API_KEY=
# EMBY_USERNAME=
# JELLYFIN_URL=http://localhost:8096
# JELLYFIN_API_KEY=
# JELLYFIN_USERNAME=

# Host paths mapped to container download folders
MOVIES_PATH=./downloads/movies
TV_PATH=./downloads/tv
TV2_PATH=./downloads/tv2
