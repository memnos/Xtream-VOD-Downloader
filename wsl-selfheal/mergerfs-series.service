[Unit]
After=wsl-hdd-mount.service
Requires=wsl-hdd-mount.service
Description=mergerfs Serie TV (HDD1 + m3u-editor strm)
After=local-fs.target network-online.target mergerfs-movies.service
Before=docker.service containerd.service mergerfs.target
PartOf=mergerfs.target
RequiresMountsFor=/mnt/wsl/HDD1
# Non bloccarsi mai sul rate-limit "Start request repeated too quickly"
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
# Pulisce un eventuale mount FUSE rimasto appeso (stale) prima di rimontare.
# Il prefisso '-' rende l'errore non fatale quando non c'e' nulla da smontare.
ExecStartPre=-/bin/umount -l /mnt/wsl/union/Serie_Tv
ExecStartPre=/bin/mkdir -p /mnt/wsl/union/Serie_Tv
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do mountpoint -q /mnt/wsl/HDD1 && test -d /mnt/wsl/HDD1/Serie_Tv && test -d /home/fabio/m3u-editor/series && exit 0; sleep 1; done; echo "HDD1 Serie_Tv o m3u-editor non pronti"; exit 1'
ExecStart=/usr/bin/mergerfs -o allow_other,use_ino,category.create=ff,minfreespace=4G,fsname=mergerfs_Serie_Tv /mnt/wsl/HDD1/Serie_Tv:/home/fabio/m3u-editor/series /mnt/wsl/union/Serie_Tv
ExecStop=/usr/bin/fusermount3 -u /mnt/wsl/union/Serie_Tv
# Se mergerfs muore, riprova da solo
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target mergerfs.target
